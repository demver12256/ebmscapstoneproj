# Existing EBMS API port. The React frontend uses port 3000.
PORT=5000

# PhilSMS dashboard credentials
PHILSMS_API_TOKEN=your_philsms_api_token_here
# API v3 base URL shown in the supplied dashboard documentation
PHILSMS_API_BASE_URL=https://dashboard.philsms.com/api/v3
# Replace with the sender ID registered to your account (maximum 11 characters)
PHILSMS_SENDER_ID=PhilSMS

# Optional: messages submitted per dispatch cycle (1-25)
PHILSMS_BATCH_SIZE=5

# SMTP account used to email password-recovery codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
JWT_EXPIRES_IN=30d
